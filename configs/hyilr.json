{
  "id": "hyilr",
  "cwd": "baselines",
  "pythonpath": [
    "baselines",
    "baselines/vendor"
  ],
  "environment": "environments/htc-cuda.txt",
  "scope_note": "Selected historical configuration; test disabled until checkpoint and decoder freeze. Historical HyILR selected weight .6, not library default .3.",
  "argv": [
    "{python}",
    "train_recent_htc.py",
    "--data-dir",
    "{data_dir}",
    "--output-dir",
    "{work_dir}/hyilr",
    "--base-model",
    "{base_model}",
    "--seed",
    "13",
    "--learning-rate",
    "1e-5",
    "--max-length",
    "512",
    "--early-stop",
    "6",
    "--warmup-steps",
    "0",
    "--eval-batch-size",
    "64",
    "--pretokenize",
    "--num-workers",
    "4",
    "--skip-test",
    "--method",
    "hyilr",
    "--batch-size",
    "10",
    "--contrastive-weight",
    "0.6",
    "--temperature",
    "0.07",
    "--max-epochs",
    "6"
  ]
}
