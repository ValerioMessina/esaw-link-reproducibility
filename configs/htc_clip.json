{
  "id": "htc_clip",
  "cwd": "baselines",
  "pythonpath": [
    "baselines",
    "baselines/vendor"
  ],
  "environment": "environments/htc-cuda.txt",
  "scope_note": "Reconstruction configuration matching the selected seed3 tuning checkpoint family, with explicit 50-epoch cap; not a claim of reexecuted historical selection. Source launcher retains the original tuning grid and final seed13 plan.",
  "argv": [
    "{python}",
    "train_htc_clip.py",
    "--architecture",
    "htc-clip",
    "--data-dir",
    "{data_dir}",
    "--output-dir",
    "{work_dir}/htc_clip",
    "--base-model",
    "{base_model}",
    "--seed",
    "3",
    "--batch-size",
    "56",
    "--gamma",
    "0.02",
    "--contrastive-weight",
    "0.05",
    "--temperature",
    "1",
    "--learning-rate",
    "3e-5",
    "--max-length",
    "512",
    "--max-epochs",
    "50",
    "--early-stop",
    "6",
    "--skip-test",
    "--eval-batch-size",
    "128",
    "--path-hidden",
    "128",
    "--pretokenize",
    "--num-workers",
    "4"
  ]
}
