{
  "id": "refinement_h4",
  "cwd": "retriever",
  "pythonpath": [
    "retriever"
  ],
  "environment": "retriever; historical ranges, freeze your actual runtime",
  "scope_note": "Continuation from final phase1; no class-identity mask in historical MNRL. H8 is alternative refinement.",
  "argv": [
    "{python}",
    "-m",
    "esaw_biencoder.train",
    "--dataset",
    "{dataset}",
    "--taxonomy",
    "{taxonomy}",
    "--split-file",
    "{split_file}",
    "--output-dir",
    "{work_dir}/refinement_h4",
    "--base-model",
    "{phase1_model}",
    "--epochs",
    "1",
    "--batch-size",
    "24",
    "--learning-rate",
    "8e-6",
    "--mnrl-hard-negatives-per-positive",
    "4",
    "--mnrl-hardness-mode",
    "hard-negatives",
    "--mnrl-hardness-strength",
    "0.2",
    "--hard-negative-file",
    "{hard_negatives}",
    "--device",
    "cuda",
    "--loss",
    "mnrl",
    "--optimizer",
    "adafactor",
    "--max-seq-length",
    "256",
    "--torch-dtype",
    "bfloat16",
    "--text-format",
    "v5",
    "--validation-ratio",
    "0.1",
    "--test-ratio",
    "0.1",
    "--seed",
    "13",
    "--max-validation-examples",
    "1000",
    "--evaluation-steps",
    "0",
    "--warmup-ratio",
    "0.1"
  ]
}
