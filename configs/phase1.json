{
  "id": "phase1",
  "cwd": "retriever",
  "pythonpath": [
    "retriever"
  ],
  "environment": "retriever; historical ranges, freeze your actual runtime",
  "scope_note": "Final three-epoch encoder, not checkpoint10000. Full supervised retrieval tuning.",
  "argv": [
    "{python}",
    "-m",
    "esaw_biencoder.train",
    "--dataset",
    "{dataset}",
    "--taxonomy",
    "{taxonomy}",
    "--split-file",
    "{split_file}",
    "--output-dir",
    "{work_dir}/phase1",
    "--model-preset",
    "qwen3-embedding-0.6b",
    "--epochs",
    "3",
    "--batch-size",
    "80",
    "--learning-rate",
    "2e-5",
    "--device",
    "cuda",
    "--loss",
    "mnrl",
    "--optimizer",
    "adafactor",
    "--max-seq-length",
    "256",
    "--torch-dtype",
    "bfloat16",
    "--text-format",
    "v5",
    "--validation-ratio",
    "0.1",
    "--test-ratio",
    "0.1",
    "--seed",
    "13",
    "--max-validation-examples",
    "1000",
    "--evaluation-steps",
    "0",
    "--warmup-ratio",
    "0.1"
  ]
}
